# Copy to .env for local runs; on Railway set the same names as service variables.
# Only the first block is required to start; each later block switches on one part of the assistant.

# --- Required: Telegram + Gemini (stages 1-2) ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (the bot ignores everyone else; ask @userinfobot)
OWNER_TELEGRAM_ID=
# Your time zone (IANA name); it moves with you when you tell the assistant you're in another city
OWNER_TIMEZONE=Europe/Lisbon
# Gemini API key from Google AI Studio (enable billing: the free tier is too limited)
GEMINI_API_KEY=
# Optional: public base URL. On Railway, RAILWAY_PUBLIC_DOMAIN is used automatically.
PUBLIC_URL=

# --- Memory: Supabase (stage 3) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Local only, for scripts/migrate.py. Never set these on Railway.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# --- Google (Gmail, Calendar, Drive, Sheets, Forms, YouTube) and Notion (stage 4) ---
# Google OAuth "Desktop app" client; get the refresh token with: python scripts/google_auth.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
NOTION_TOKEN=
# Page where new Notion pages go by default (shared with the integration)
NOTION_DEFAULT_PAGE_ID=
# Database where "add an idea" goes (optional)
NOTION_IDEAS_DATABASE_ID=

# --- Morning brief (stage 5) ---
# First-run time of the daily brief (your local time; change it later by chat)
BRIEF_TIME=08:00
# Markets: CoinGecko id:symbol, Yahoo Finance ticker:name, ECB currency pairs
BRIEF_CRYPTO=bitcoin:BTC,ethereum:ETH
BRIEF_INDEXES=^GSPC:S&P 500
BRIEF_CURRENCIES=USD/EUR

# --- GitHub (stage 8): fine-grained token, Contents read-only + Issues read/write ---
GITHUB_TOKEN=

# --- Your other AI agents report here (stage 9); generate a long random string ---
AGENTS_TOKEN=

# --- Voice: calls in Telegram, the Mac, the phone (stages 10-12) ---
ASSISTANT_NAME=Lucy
# Gemini voice (Achernar is a soft female voice)
GEMINI_VOICE=Achernar
# Languages you may speak (speech recognition hints; replies are English unless you ask)
# VOICE_LANGUAGE_CODES=en-US,es-ES
# Pause (ms) that ends your phrase
# VOICE_SILENCE_MS=700
MAX_CALL_MINUTES=60

# --- Jarvis, the Mac app (stage 11); generate a long random string ---
JARVIS_TOKEN=
# Step limit for one Mac task
# MAC_MAX_STEPS=25

# --- Phone calls with Twilio (stage 12) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Lucy's number, bought in Twilio, e.g. +15551234567
TWILIO_PHONE_NUMBER=
# How Lucy names you on calls ("an AI assistant calling on behalf of ...")
OWNER_NAME=
# Your own phone in +country format: Lucy calls it ("call me"); calls from it get the full assistant
OWNER_PHONE_NUMBER=
# Optional (defaults shown)
# OWNER_CALL_PIN=            keypad PIN for your calls to Lucy (caller ID can be faked)
# PHONE_GUEST_MESSAGES=true  other callers can leave a message (false = they're hung up on)
# GUEST_CALL_MINUTES=3
# PHONE_MAX_MINUTES=10
# PHONE_RECORD_CALLS=true
# Call some countries from another verified number if their networks reject Lucy's number
# ALT_CALLER_ID=
# ALT_CALLER_ID_PREFIXES=+44,+49

# --- Spending (stage 13) ---
# Daily limit in USD for Gemini + Twilio (0 = no limit). /usage shows today and this month.
DAILY_COST_LIMIT_USD=5

# --- Optional model overrides (defaults live in app/config.py; check Google AI Studio for current names) ---
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=low
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_LIVE_MODEL=gemini-3.8-live
